# ===== 必填 =====
# 从 @BotFather 获取的 Bot Token（格式示例：123456789:<telegram_bot_token>）
TG_BOT_TOKEN=your_bot_token_here
# 管理员的 Telegram 数字 ID，逗号分隔，如：123456789,987654321
# 不填时 /status /settings /upgrade 等管理员命令对任何人都不开放
ADMIN_IDS=

# ===== 代理（可选）=====
# 机器人访问 Telegram/GitHub、搜索引擎访问搜索来源都会使用；机器人访问本机搜索引擎不走代理
HTTP_PROXY=
HTTPS_PROXY=

# ===== 搜索引擎在线升级 =====
# 多久检查一次搜索引擎新版本（小时），0 关闭自动检查；/upgrade 始终可以手动使用
UPGRADE_CHECK_HOURS=24
# 发现新版本时直接升级（false 只私信提醒管理员）
AUTO_UPGRADE=false
# 从哪个 GitHub 仓库的 Releases 下载搜索引擎
# UPGRADE_REPO=Tumblr-code/pansou-bot

# ===== PanSou 搜索引擎自己的配置（可选）=====
# 留空时使用当前搜索引擎版本附带的上游默认值。其他 PanSou 配置项也可以直接写在这里
# CHANNELS=
# ENABLED_PLUGINS=
# CACHE_TTL=60

# ===== 搜索 =====
DEFAULT_RESULT_LIMIT=10
MAX_RESULT_LIMIT=20
SEARCH_TIMEOUT=30
# 机器人这边的默认频道/插件筛选，逗号分隔；留空表示使用搜索引擎的全部频道和插件
DEFAULT_CHANNELS=
DEFAULT_PLUGINS=
MAX_CONCURRENT_SEARCHES=4
SEARCH_QUEUE_TIMEOUT=8
MAX_KEYWORD_LENGTH=128
# 每个用户每分钟最大请求数
RATE_LIMIT_PER_MINUTE=10

# ===== 运行 =====
# 日志级别：DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
DROP_PENDING_UPDATES=false
# Docker 镜像里固定为 /data；不用 Docker 时为用户设置和搜索引擎数据的保存目录
# DATA_DIR=./data

# ===== TMDB 影视信息（可选，填其中一个即可）=====
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
